# 一台機的安裝資訊。複製成 drone-<代號>.env（已 gitignore）填好，然後：
#
#   ./deploy.sh --env drone-<代號>.env
#
# **每一欄都要填才會開始**：deploy.sh 在連線之前先檢查，缺哪一欄就說哪一欄、什麼都不做。
# 含密碼：這個範本進 git，填好的那份不進（.gitignore 的 drone-*.env）。

# ── 連線（必填）──
# Pi 的位址。現場位址常常是臨時的，換了就改這一行
UAV_PI_HOST=
# 登入帳號。代理也以這個帳號執行（不一定是 pi）
UAV_PI_USER=
# 登入密碼。只用在第一次裝 SSH 金鑰與設免密碼 sudo；之後全程用金鑰
UAV_PI_PASS=

# ── 這台機的代理參數（必填）──
# 寫進機上的 /etc/uav-agent.env，蓋過 unit 的共用預設值
# 地面站位址（遙測、記錄通道、對時都用它）
GS_HOST=
# 5G dongle 的 AT 埠（Fibocom FM160 通常是 /dev/ttyUSB1）
MODEM_PORT=
# 飛控出廠的 MAVLink sysid（ArduPilot 預設 1；之後地面站會配號）
FC_SYSID=
# 飛控序列埠鮑率（unit 預設 57600；**不一定**——第二台機的飛控是 115200）
FC_BAUD=

# ── 機體（選填：不填＝不碰飛控的電池參數，那幾個門檻標「沒有檢查」）──
# 電池幾 S（4 → LOW 14.0 V、CRT 13.2 V）
BATT_CELLS=
# 電池容量 mAh（剩餘電量百分比是用它算的）
BATT_CAPACITY_MAH=
# 飛控基準參數：apply＝部署時寫進並讀回核對（序列埠設定會自動重開飛控）；check＝只列差異
FC_PARAMS=check
