[Unit]
Description=機上智能代理：飛控 ←→ 地面站 橋接與監控
# 飛控可能比 Pi 晚上電、5G 模組也要時間註冊網路；兩者都靠 Restart 處理，
# 這裡只要求網路堆疊就緒即可，不要 Requires 任何會讓它拒絕啟動的東西。
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
SupplementaryGroups=dialout
# 看得到**所有**行程開著哪些檔（uav-system 059 B：誰還開著飛控序列埠）。
# 沒有它，root 行程的 /proc/<pid>/fd 全是 EACCES——而 root 正是 TIOCEXCL 擋不住、
# 最需要被抓到的那一種（09-16 的 sudo uart-probe.sh）。
# pi 本來就有免密碼 sudo，這沒有讓代理多出任何它原本拿不到的權力。
AmbientCapabilities=CAP_SYS_PTRACE
WorkingDirectory=/opt/uav-agent

# ── 部署參數（改這裡，不要改程式碼）──────────────────────────
Environment=GS_HOST=10.141.2.21
Environment=FC_DEV=/dev/ttyAMA0
# 這個代理只綁這個 sysid 的飛控；飛控從其他 MAVLink 埠轉過來的別台機一律不轉發
Environment=FC_SYSID=1
Environment=FC_BAUD=57600
Environment=RATE=4
Environment=MODEM_PORT=/dev/ttyUSB1
# ── 地面失聯處置（飛安相關）────────────────────────────────
# LINK_ACTION=none 可停用自動處置，只保留告警
Environment=LINK_WARN_S=5
# **不可以等於單飛上限（30）**：處置要等 LINK_ACTION_S 才開始評估，而單飛
# 時間從失聯那一刻起算——兩者相等時，第一次評估當下單飛時間就已達上限，
# 「任務中續飛」那條分支永遠走不到，選項 C 安靜地退化成「一律 RTL」。
# 代理每次啟動都會警告這件事，而它警告了好幾個星期沒有人改。
Environment=LINK_ACTION_S=10
Environment=LINK_ACTION=rtl
# ── 機上錄製與它的自動回傳（uav-system issues/014）──────────────
# 錄的是「飛控送出的東西」（地面站錄的是「送到地面站的東西」）——
# **5G 斷線期間，兩者相差的正是我們最想看的那一段**。
# 回傳**只在地面進行、一解鎖立刻停**：一趟十分鐘的錄製約 4 MB，量不是問題，
# 問題是它與遙測共用同一條 5G，而正在飛的那台優先。
# RECORD_UPLOAD=0 可退回「落地後人工 scp」。
Environment=RECORD_UPLOAD=1
Environment=RECORD_UPLOAD_KBPS=256
Environment=RECORD_UPLOAD_SETTLE_S=20
# 錄製 spool 也搬出家目錄（躲誤刪）；預設 /home/pi/uav-record 被這行覆蓋
Environment=RECORD_DIR=/opt/uav-record

ExecStart=/opt/uav-agent/venv/bin/python /opt/uav-agent/agent.py
Restart=always
RestartSec=3

# 這條鏈路是飛控與地面站之間的唯一通道，掛掉等於雙向失聯 —— 提高優先權
Nice=-5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=uav-agent

[Install]
WantedBy=multi-user.target
